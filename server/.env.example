# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# Confirm the current Flash model ID in AI Studio; previews change.
GEMINI_MODEL=gemini-2.5-flash
# Fast model that decides whether you've finished speaking.
GEMINI_TURN_MODEL=gemini-2.5-flash-lite
# Text-to-speech model for the natural voices.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
