# Which service writes the replies and runs the checks: gemini (default), groq or grok.
# The natural voices always use Gemini, so keep a Gemini key for them (or pick Device voices).
LLM_PROVIDER=gemini

# Groq (LLM_PROVIDER=groq): very fast, free tier without a card. Key: https://console.groq.com/keys
# Several keys rotate the same way as Gemini's: GROQ_API_KEYS=key1,key2 or GROQ_API_KEY_2, _3, …
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile      # replies, safety, exercises, memory
# GROQ_FAST_MODEL=llama-3.1-8b-instant     # quick checks (end of turn, suggestions)
# With a Groq key set (whatever LLM_PROVIDER is), each spoken turn is also transcribed by Whisper,
# which understands accents and mumbling far better than the browser's built-in recognition.
# GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Grok by xAI (LLM_PROVIDER=grok): paid credits. Key: https://console.x.ai
# XAI_API_KEY=                              (or XAI_API_KEYS=key1,key2)
# GROK_MODEL=grok-4.3
# GROK_REASONING_EFFORT=none

# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# More keys (optional): each call goes to the next key in turn, and a key that hits its quota or
# stops working is skipped for a while (server/keys.py). Comma-separated, or GEMINI_API_KEY_2, _3, …
# GEMINI_API_KEYS=key1,key2,key3
# Confirm current model IDs in AI Studio. The 2.5 models no longer work with new keys (404 "no longer available to new users").
GEMINI_MODEL=gemini-3.8-flash
# Fast model that decides whether you've finished speaking.
GEMINI_TURN_MODEL=gemini-3.5-flash-lite
# Text-to-speech model for the natural voices.
GEMINI_TTS_MODEL=gemini-3.8-flash-tts
# Faster, made for voice agents: gemini-3.8-flash-lite-tts
# Labels each message normal/crisis (step 3). Runs alongside every reply.
GEMINI_SAFETY_MODEL=gemini-3.5-flash-lite
# Tried when the safety model fails (e.g. its quota is used up). Default: GEMINI_MODEL.
# GEMINI_SAFETY_FALLBACK_MODEL=gemini-3.8-flash

# Crisis card and script (step 3). Set these for the country your users are in, e.g.
#   US: 988 Suicide & Crisis Lifeline / 988, emergency 911
#   UK: Samaritans / 116 123, emergency 999
#   India: Tele-MANAS / 14416, emergency 112
# With no helpline number, the card links to findahelpline.com instead.
CRISIS_HELPLINE_NAME=
CRISIS_HELPLINE_NUMBER=
EMERGENCY_NUMBER=112

# Memory (step 4): notes pulled from each session at the end, and the greeting for returning users.
GEMINI_MEMORY_MODEL=gemini-3.8-flash
# Where memories are stored (SQLite). Default: server/memory.db
# MEMORY_DB=/path/to/memory.db

# Action and follow-through (step 5).
# Fast model for: should we suggest something now? yes / later / no? did it help?
GEMINI_ACTION_MODEL=gemini-3.5-flash-lite
# Writes each guided exercise (structured JSON, checked on the server).
GEMINI_EXERCISE_MODEL=gemini-3.8-flash

# Feedback loop (step 6) needs no settings: the action types and scoring are in server/feedback.py
# (TYPES, DECAY, EXPLORE_BONUS), and the type to suggest is picked in code, with no extra Gemini calls.
