# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=your-key-here
# More keys (optional): each call goes to the next key in turn, and a key that hits its quota or
# stops working is skipped for a while (server/keys.py). Comma-separated, or GEMINI_API_KEY_2, _3, …
# GEMINI_API_KEYS=key1,key2,key3
# Confirm the current Flash model ID in AI Studio; previews change.
GEMINI_MODEL=gemini-2.5-flash
# Fast model that decides whether you've finished speaking.
GEMINI_TURN_MODEL=gemini-2.5-flash-lite
# Text-to-speech model for the natural voices.
GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
# Labels each message normal/crisis (step 3). Runs alongside every reply.
GEMINI_SAFETY_MODEL=gemini-2.5-flash-lite

# Crisis card and script (step 3). Set these for the country your users are in, e.g.
#   US: 988 Suicide & Crisis Lifeline / 988, emergency 911
#   UK: Samaritans / 116 123, emergency 999
#   India: Tele-MANAS / 14416, emergency 112
# With no helpline number, the card links to findahelpline.com instead.
CRISIS_HELPLINE_NAME=
CRISIS_HELPLINE_NUMBER=
EMERGENCY_NUMBER=112

# Memory (step 4): notes pulled from each session at the end, and the greeting for returning users.
GEMINI_MEMORY_MODEL=gemini-2.5-flash
# Where memories are stored (SQLite). Default: server/memory.db
# MEMORY_DB=/path/to/memory.db

# Action and follow-through (step 5).
# Fast model for: should we suggest something now? yes / later / no? did it help?
GEMINI_ACTION_MODEL=gemini-2.5-flash-lite
# Writes each guided exercise (structured JSON, checked on the server).
GEMINI_EXERCISE_MODEL=gemini-2.5-flash

# Feedback loop (step 6) needs no settings: the action types and scoring are in server/feedback.py
# (TYPES, DECAY, EXPLORE_BONUS), and the type to suggest is picked in code, with no extra Gemini calls.
